{
  "name": "bb-plugin-scoped-skills",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Scoped Skills",
    "description": "Give each skill only to the agents that can use it. Keep image-generation skills out of Claude threads, model-specific prompts out of the wrong model, and manage it all from one page, a CLI, or by asking an agent.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills",
      "library"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "Give each skill only to the agents and models that can use it.",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "build": "bb plugin build"
  },
  "keywords": [
    "bb-plugin",
    "skills",
    "agents"
  ],
  "license": "MIT",
  "author": "notpritam <notpritamsharma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/notpritam/bb-plugin-scoped-skills.git"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
